# Set through Sites runtime environment variables for production. No value is committed.
# First sign-in with this exact verified email creates the initial administrator once.
SITE_BOOTSTRAP_ADMIN_EMAIL=
# Calendar date, overdue checks and weekly management reporting time zone.
SITE_TIME_ZONE=Asia/Dubai
# Local preview only. Never used by production request handlers.
SITE_PREVIEW_ROLE=administrator
SITE_PREVIEW_PROJECT_IDS=
